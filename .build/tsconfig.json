{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "./*.mjs",
    "../packages/*/build.mjs",
    "../packages/icons-solidjs/build.js",
    "../packages/icons-webfont/.build/*.mjs"
  ]
}
